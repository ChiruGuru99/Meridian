# Meridian. Requires Docker (Compose v2) and make; test targets also need the
# toolchains listed in README.md (JDK 21 + Maven, Go, Python, Node).
SHELL := /bin/bash
COMPOSE := docker compose

.PHONY: help up down clean build ps logs proto test test-ledger test-gateway test-recon test-console \
        e2e chaos load seed demo recon

help:
	@grep -E '^[a-z-]+:.*?## ' $(MAKEFILE_LIST) | awk -F':.*?## ' '{printf "  %-14s %s\n", $$1, $$2}'

up: ## build and start the whole system, wait until healthy
	$(COMPOSE) up -d --build --wait

down: ## stop everything (keeps data)
	$(COMPOSE) down

clean: ## stop everything and delete all data
	$(COMPOSE) down -v --remove-orphans

ps: ## service status
	$(COMPOSE) ps

logs: ## follow logs
	$(COMPOSE) logs -f --tail=100

proto: ## regenerate Go gRPC stubs (Java stubs are generated by Maven)
	cd payment-gateway && protoc -I ../proto \
	  --go_out=gen/ledgerv1 --go_opt=module=meridian/gateway/gen/ledgerv1 \
	  --go-grpc_out=gen/ledgerv1 --go-grpc_opt=module=meridian/gateway/gen/ledgerv1 \
	  ledger/v1/ledger.proto

test: test-ledger test-gateway test-recon test-console ## all unit, property and Testcontainers integration tests

test-ledger: ## ledger unit, jqwik property, concurrency and Testcontainers tests
	cd ledger-service && mvn -B -q verify

test-gateway: ## gateway unit, rapid property and Testcontainers tests
	cd payment-gateway && go vet ./... && go test -count=1 ./...

test-recon: ## reconciliation tests
	cd reconciliation && python3 -m venv .venv && .venv/bin/pip -q install -e '.[test]' && .venv/bin/pytest -q

test-console: ## ops-console type check and tests
	cd ops-console && npm ci --no-audit --no-fund && npm run typecheck && npm test

e2e: ## end-to-end tests against the running stack (make up first)
	cd payment-gateway && go test -tags e2e -count=1 -v ./e2e/

chaos: ## failure tests: kills services, stops the broker, freezes the database (make up first)
	cd payment-gateway && go test -tags chaos -count=1 -v -timeout 20m ./e2e/

load: ## k6 load test against the running stack
	$(COMPOSE) --profile tools run --rm k6 run /scripts/load.js

seed: ## load sample accounts and payments
	$(COMPOSE) --profile tools run --rm demo python /scripts/demo.py seed

recon: ## generate today's bank statement (with injected breaks) and reconcile it
	$(COMPOSE) exec reconciliation python -m recon generate-statement --out /data/statement.csv
	$(COMPOSE) exec reconciliation python -m recon run --statement /data/statement.csv

demo: up ## start everything, seed data, run the scripted payments and reconciliation
	$(COMPOSE) --profile tools run --rm demo python /scripts/demo.py demo
